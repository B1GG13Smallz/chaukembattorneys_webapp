@{
    ViewData["Title"] = "Client Login";
}

<section class="page-title compact">
    <p class="eyebrow">Client portal</p>
    <h1>Client login</h1>
    <p>Authentication is scaffolded for the lite portal. Add ASP.NET Core Identity or JWT integration before production use.</p>
</section>

<section class="form-section narrow">
    <form class="intake-form single">
        <label>Email<input type="email" required /></label>
        <label>Password<input type="password" required /></label>
        <button class="button primary" type="submit">Sign In</button>
    </form>
</section>
