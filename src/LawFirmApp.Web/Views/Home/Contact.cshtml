@{
    ViewData["Title"] = "Contact";
}

<section class="page-title visual-title contact-visual">
    <p class="eyebrow">Contact</p>
    <h1>Request legal help</h1>
    <p>Replace placeholders with the approved office address, phone, email, WhatsApp number, and map embed.</p>
</section>

<section class="two-column contact-content">
    <form class="intake-form single">
        <label>Full name<input required /></label>
        <label>Email<input type="email" required /></label>
        <label>Phone<input required /></label>
        <label>Message<textarea rows="6" required></textarea></label>
        <button class="button primary" type="submit">Send Message</button>
    </form>
    <aside class="panel">
        <h2>Office details</h2>
        <p>Address: 23 NoordRand Road, Deutronomy Building, Kempton Park, 1619</p>
        <p>Phone: +27 00 000 0000</p>
        <p>Email: info@example.co.za</p>
        <p>WhatsApp: +27 00 000 0000</p>
    </aside>
</section>
